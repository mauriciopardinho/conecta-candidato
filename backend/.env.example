# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados
# Dev: SQLite local (arquivo). Produção: aponte para um Postgres, ex:
# DATABASE_URL=postgres://usuario:senha@host:5432/conecta_candidato
DATABASE_URL=sqlite:./database.sqlite

# JWT
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=troque-esta-outra-chave-em-producao
JWT_REFRESH_EXPIRES_IN=30d

# WhatsApp (integração futura — camada de abstração já pronta)
WHATSAPP_PROVIDER=stub
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
